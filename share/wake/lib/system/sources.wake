package wake

# The source topic is used to inform wake about source files.
# Normally, wake obtains this information from git.
# However, in a distribution tarball this information is not available.
# In that situation, provide a manifest.wake which publishes to this topic.
# Anything published to this topic will be returned by calls to `sources`.
export topic source: String

# Private implementation of global sources
def add_sources str =
    prim "add_sources"

def got_sources =
    add_sources (subscribe source | map simplify | implode)

# Find files
# WARNING! Use of this method can make a build unreproducible.
# Depending on when the method is invoked, the results may vary!
# This method is intended to be used by the outputFn of localRunner Jobs.
export def files (dir: String) (regexp: RegExp): List String =
    def p d r = prim "files"

    p dir regexp

# Bulk-resolves a list of source files to Paths. Splits into hits (already in the files+filetree
# cache at this mtime) and misses (stage + hash + CAS-ingest). All resolved file_ids are pinned
# in this run via a synthetic source-aggregator job created by sources_register_filetree.

def fileTimeForSource file =
    def get_modtime file = prim "get_modtime"
    def time = get_modtime file

    if time == -1 then
        failWithError "{file}: source does not exist. Did you delete it or move it without telling git?"
    else
        Pass (Pair file time)

def fileTimeToLine pair =
    def Pair f t = pair

    "{f}\t{str t}"

# Path and PathInfo share the same five fields; converting between them is a tuple-to-tuple map.
# By the time we make Paths, the metadata has been recorded in the files DB (via the registers).
def sourcePathInfoToPath (PathInfo n t h m mt) = Path n t h m mt

# Hit entries from sources_lookup come back as nested-Pair PathInfoRaw:
# (name, (type, (hash, (mode, mtimeNs)))). Lift to PathInfo.
def parseSourcePathInfo entry =
    def Pair name rest1 = entry
    def Pair pathTypeString rest2 = rest1
    def Pair hash rest3 = rest2
    def Pair mode mtimeNs = rest3

    require Pass pathType = pathTypeFromString pathTypeString
    else panic "Unknown path type '{pathTypeString}' for {name}"

    Pass (PathInfo name pathType hash mode mtimeNs)

# Convert a stage_outputs raw entry (destPath, type, stagingPathOrTarget, mode, mtimeSec,
# mtimeNsec) into a wake-side StagingItem so we can reuse prepareStagingOutputs (which knows
# how to hash files via wake-hash, symlinks via target string, dirs via dirHash).
def stagedRawToStagingItem entry =
    def Pair destPath rest1 = entry
    def Pair itemType rest2 = rest1
    def Pair stagingPathOrTarget rest3 = rest2
    def Pair mode rest4 = rest3
    def Pair mtimeSec mtimeNsec = rest4

    match itemType
        "file" ->
            Pass (StagingFile (StagingFileOutput destPath stagingPathOrTarget mode mtimeSec mtimeNsec))
        "symlink" ->
            Pass (StagingSymlink (StagingSymlinkOutput destPath stagingPathOrTarget mtimeSec mtimeNsec))
        "directory" ->
            Pass (StagingDirectory (StagingDirectoryOutput destPath mode mtimeSec mtimeNsec))
        t -> failWithError "Unknown staging entry type from stage_outputs: {t}"

# Project a PreparedStagingItem onto the (path, type, hash, mode, mtimeNs) shape sources_register
# expects on the wire.
def preparedToRegisterLine prepared =
    def item = prepared.getPreparedStagingItemItem
    def hash = prepared.getPreparedStagingItemHash
    def destPath = item.getStagingItemDestPath
    def pathType = pathTypeToString item.getStagingItemPathType
    def mode = item.getStagingItemMode
    def mtimeNs = item.getStagingItemMtimeNs

    "{destPath}\t{pathType}\t{hash}\t{str mode}\t{str mtimeNs}"

def hitToRegisterLine entry =
    def Pair name rest1 = entry
    def Pair pathType rest2 = rest1
    def Pair hash rest3 = rest2
    def Pair mode mtimeNs = rest3

    "{name}\t{pathType}\t{hash}\t{str mode}\t{str mtimeNs}"

def raw_sources files =
    def sources_lookup linesArg = prim "sources_lookup"
    def sources_register_files linesArg = prim "sources_register_files"
    def sources_register_filetree cmdArg linesArg = prim "sources_register_filetree"
    def stage_outputs_prim pathsLines stagingBase = prim "stage_outputs"

    # 1. Resolve mtimes; fail naming the offending file if any source is missing.
    require Pass fileTimes = files | map fileTimeForSource | findFail

    # 2. Bulk lookup.
    def lookupLines = catWith "\n" (map fileTimeToLine fileTimes)

    require Pass (Pair hits misses) =
        sources_lookup lookupLines
        | rmapFail (\msg failWithError "sources_lookup failed: {msg}")

    # 3. For misses: stage, then run prepareStagingOutputs to compute correct hashes per type
    # (files via wake-hash on staging paths, symlinks via target string, directories via dirHash).
    def stageAndHashMisses Unit =
        def stagingBase = ".build/staging/sources.{str wakePid}"

        require Pass stageResult =
            stage_outputs_prim (catWith "\n" misses) stagingBase
            | rmapFail (\msg failWithError "sources staging failed: {msg}")

        def Pair _stagingRoot rawEntries = stageResult

        require Pass stagingItems = rawEntries | map stagedRawToStagingItem | findFail

        prepareStagingOutputs "sources" stagingItems

    require Pass preparedMisses = match misses
        Nil -> Pass Nil
        _ -> stageAndHashMisses Unit

    # 4. Insert files + run_files for ALL entries (hits + misses). Hits' file row already exists
    # so insert-or-ignore is a no-op; the run_files claim is what newly pins them for this run.
    def missRegisterLines = map preparedToRegisterLine preparedMisses
    def hitRegisterLines = map hitToRegisterLine hits
    def registerLines = catWith "\n" (hitRegisterLines ++ missRegisterLines)

    require Pass _ =
        sources_register_files registerLines
        | rmapFail (\msg failWithError "sources_register_files failed: {msg}")

    # 5. CAS-ingest each miss (handles all three types correctly via ingestPreparedStagingItemIntoCas).
    # Hits skip this — their blobs are already in CAS from the run that originally registered them.
    require Pass _ = preparedMisses | map ingestPreparedStagingItemIntoCas | findFail

    # 6. Create the synthetic source-aggregator job and link filetree(access=2) entries for all
    # entries (hits + misses), pinning the file_ids cross-run via the job's lifetime.
    require Pass registered =
        sources_register_filetree lookupLines registerLines
        | rmapFail (\msg failWithError "sources_register_filetree failed: {msg}")

    # 7. Convert PathInfos to Paths.
    require Pass pathInfos = registered | map parseSourcePathInfo | findFail

    Pass (map sourcePathInfoToPath pathInfos)


export def source (file: String): Result Path Error =
    def base = basename file
    def dir = dirname file

    require Pass allSources = sources dir base.quote

    match allSources
        Nil -> failWithError "{file}: not a source file"
        x, Nil -> Pass x
        _ -> unreachable "a quoted RegExp can never match more than one distinct String"

# Allows claiming of a file so long as the file is within
# wake's workspace. Keep in mind that if another job
# produced this file in the same run of wake, claim will
# fail. Likewise if you claim a file then any job that
# produces this file will fail. Claim should be thought
# of as a "virtual" job and wake demands that all paths
# be produced by exactly one job, virtual or otherwise.
#
# For source files please use `source`. For files outside
# of wake's workspace please use `claimFileAsPath` or
# `claimFileAsPathIn`. `claim` is good for claiming
# artifacts of previous builds that should not be rebuilt
# during this run.
#
# Parameters:
#  - `file`: The string giving the path to the file to be claimed
#
# Example:
# ```
#   claim "build/my_flow/my_step/previous-output.txt" # Claims the file
# ```
export def claim (file: String): Result Path Error =
    # Define the actual virtual job that produces the Path
    def raw_claim file =
        def get_modtime file = prim "get_modtime"
        def time = get_modtime file

        if time == -1 then
            failWithError "{file}: file does not exist. Maybe you haven't previously built this file?"
        else
            # Its important that the command here is distinct from what `source` would use
            # so that claim and source do not overlap.
            makeExecPlan ("<claim>", str time, file, Nil) Nil
            | setPlanLabel "claim: {file}"
            | setPlanShare False
            | setPlanEcho logDebug
            | setPlanEnvironment Nil
            | setPlanFnOutputs (file, _)
            | setPlanEcho logDebug
            | runJobWith virtualRunner
            | setJobInspectVisibilityHidden
            | getJobOutput

    # Compute the relative path in simplest form
    def isAbs = matches `/.*` file

    def relPath =
        if isAbs then
            relative workspace file
        else
            simplify file

    # Fail if we're outside of wake's workspace (relPath must be simplified)
    def isOutsideRoot = matches `\.\..*/.*` relPath

    require False = isOutsideRoot
    else
        failWithError
        "{file}: claim cannot be used on files outside of wake's workspace. Consider using claimFileAsPath instead."

    # Now that our path is uniform check if it could have been fetched with `source`
    def base = basename relPath
    def dir = dirname relPath
    def scan dir regexp = prim "sources"
    def canBeSourced = exists (_ ==~ relPath) (scan dir base.quote)

    require False = canBeSourced
    else failWithError "{file}: Is a source file, please use `source` or `sources` instead of `claim`"

    # Finally if the file is inside of wake's workspace and can't be sourced we're in the clear
    raw_claim relPath

# Find sources files
export def sources (dir: String) (filterRegexp: RegExp): Result (List Path) Error =
    def scan dir regexp = prim "sources"

    match got_sources
        True -> match (scan dir filterRegexp)
            Nil -> Pass Nil
            files -> raw_sources files
        False -> unreachable "add_sources always returns True"

# This API makes it possible to include a non-source file into a wake build.
# Generally, one should obtain Paths from sources or as the output of Jobs.
# This API is useful for things like a command-line-supplied input file.
export def claimFileAsPath (existingFile: String) (desiredWorkspacePath: String): Result Path Error =
    def fileName = replace `.*/` "" desiredWorkspacePath

    require Pass destDir =
        extract `(.*)/.*` desiredWorkspacePath
        | head
        | getOrElse "."
        | mkdir

    claimFileAsPathIn destDir existingFile fileName

export def claimFileAsPathIn (outputDirectory: Path) (existingFile: String) (desiredName: String): Result Path Error =
    def get_modtime file = prim "get_modtime"
    def time = get_modtime existingFile

    if time == -1 then
        failWithError "{existingFile}: claimed file does not exist"
    else
        def desiredWorkspacePath = simplify "{outputDirectory.getPathName}/{desiredName}"
        def visible = outputDirectory, Nil

        # Very specifically target `u+rw` as the minimum change required to ensure functionality;
        # `cp --no-preserve=mode` would also avoid issues when re-claiming read-only files in a
        # subsequent invocation, but it might drop an expected executable permission as well.
        """
        set -e
        cp %{existingFile} %{desiredWorkspacePath}
        chmod u+rw %{desiredWorkspacePath}
        """
        | makePlan "claim: {existingFile} -> {desiredWorkspacePath}" visible
        | setPlanPersistence Once
        | setPlanFnOutputs (\_ desiredWorkspacePath, Nil)
        # This needs to be workspaceRunner in case the existingFile is already inside the workspace.
        | runJobWith workspaceRunner
        | getJobOutput
